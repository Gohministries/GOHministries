const ALLOWED_ORIGINS = [
  "https://gohministries.github.io",
  "https://gohministries.org",
  "https://www.gohministries.org"
];

function cors(request) {
  const origin = request.headers.get("Origin");

  return {
    "Content-Type": "application/json",
    "Access-Control-Allow-Origin":
      ALLOWED_ORIGINS.includes(origin)
        ? origin
        : "https://gohministries.github.io",
    "Access-Control-Allow-Headers":
      "Content-Type",
    "Access-Control-Allow-Methods":
      "POST, OPTIONS",
    "Vary": "Origin"
  };
}

function json(request, data, status = 200) {
  return new Response(
    JSON.stringify(data),
    {
      status,
      headers: cors(request)
    }
  );
}

function escapeHTML(value) {
  return String(value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}

export default {

  async fetch(request, env) {

    if (request.method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers: cors(request)
      });
    }

    const url = new URL(request.url);

    if (
      url.pathname !== "/send-reset-email" ||
      request.method !== "POST"
    ) {
      return json(
        request,
        {
          success: false,
          error: "Endpoint not found."
        },
        404
      );
    }

    try {

      const body = await request.json();

      const email =
        String(body.email || "")
          .trim()
          .toLowerCase();

      const resetUrl =
        String(body.reset_url || "").trim();

      const name =
        String(body.name || "Student").trim();

      if (!email || !resetUrl) {
        return json(
          request,
          {
            success: false,
            error:
              "Email and reset URL are required."
          },
          400
        );
      }

      /*
       * Only allow your official reset page.
       */

      if (
        !resetUrl.startsWith(
          "https://gohministries.github.io/GOHministries/reset-password.html"
        )
      ) {
        return json(
          request,
          {
            success: false,
            error: "Invalid reset URL."
          },
          400
        );
      }

      const safeName =
        escapeHTML(name);

      const safeUrl =
        escapeHTML(resetUrl);

      const result =
        await env.EMAIL.send({

          to: email,

          from:
            "noreply@gohministries.org",

          subject:
            "Reset your GOH Bible Academy password",

          html: `
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
</head>

<body style="
  margin:0;
  padding:30px 15px;
  background:#f4f7fb;
  font-family:Arial,sans-serif;
  color:#172033;
">

<div style="
  max-width:520px;
  margin:auto;
  background:#ffffff;
  padding:35px;
  border-radius:16px;
">

<h2 style="
  margin:0 0 8px;
  color:#0b376d;
">
GOH Bible Academy
</h2>

<p style="
  color:#667085;
  margin-top:0;
">
Password Reset
</p>

<p>
Hello ${safeName},
</p>

<p>
We received a request to reset your
GOH Bible Academy student account password.
</p>

<p>
Click the button below to create a new password.
</p>

<p style="margin:28px 0;">
<a
  href="${safeUrl}"
  style="
    display:inline-block;
    padding:14px 22px;
    background:#0b376d;
    color:#ffffff;
    text-decoration:none;
    border-radius:9px;
    font-weight:bold;
  "
>
Reset Password
</a>
</p>

<p style="
  font-size:13px;
  color:#667085;
  line-height:1.6;
">
This password-reset link expires after
30 minutes.
</p>

<p style="
  font-size:13px;
  color:#667085;
  line-height:1.6;
">
If you did not request a password reset,
you can safely ignore this email.
</p>

<hr style="
  border:0;
  border-top:1px solid #e5eaf1;
  margin:25px 0;
">

<p style="
  font-size:12px;
  color:#98a2b3;
">
GOH Bible Academy<br>
Gate of Heaven Ministries
</p>

</div>

</body>
</html>
`,

          text: `
GOH Bible Academy

Password Reset

Hello ${name},

We received a request to reset your GOH Bible Academy password.

Reset your password here:

${resetUrl}

This link expires after 30 minutes.

If you did not request this password reset,
you can safely ignore this email.

GOH Bible Academy
Gate of Heaven Ministries
`
        });

      return json(
        request,
        {
          success: true,
          message: "Reset email sent.",
          message_id:
            result?.messageId || null
        }
      );

    } catch (error) {

      console.error(
        "EMAIL ERROR:",
        error
      );

      return json(
        request,
        {
          success: false,
          error:
            error?.message ||
            String(error)
        },
        500
      );
    }
  }
};
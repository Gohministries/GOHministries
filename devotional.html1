<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Daily Devotional | GOH Ministries</title>
<meta name="theme-color" content="#111827">
<link rel="icon" href="https://files.gohministries.org/file_00000000f02c82088b7cf2676012b775.png">

<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial;background:#f4f7fb;color:#172033;line-height:1.6}
a{text-decoration:none;color:inherit}
.container{width:min(900px,92%);margin:auto}

header{background:#fff;border-bottom:1px solid #e5e7eb;position:sticky;top:0;z-index:10}
.nav{height:64px;display:flex;align-items:center;justify-content:space-between}
.logo{display:flex;align-items:center;gap:9px}
.logo img{width:42px;height:42px;border-radius:9px}
.logo-title{font-size:14px;font-weight:900}
.logo-sub{font-size:8px;color:#6b7280}
.nav-links{display:flex;gap:6px}
.nav-links a{font-size:10px;font-weight:800;padding:8px}
.menu{display:none;background:#fff;border:1px solid #ddd;border-radius:8px;font-size:18px;padding:8px}

.hero{padding:18px 0 10px}
.hero-card{background:linear-gradient(135deg,#111827,#334155);color:#fff;text-align:center;padding:28px 18px;border-radius:20px}
.hero-logo{width:60px;background:#fff;border-radius:13px;padding:4px}
.label{font-size:9px;font-weight:900;letter-spacing:1px;color:#fbbf24;margin-top:8px}
h1{font-size:32px;margin:5px 0}
.date{display:inline-block;background:#ffffff18;padding:7px 15px;border-radius:8px;font-size:11px;font-weight:800}

.box{background:#fff;border:1px solid #e5e7eb;border-radius:18px;padding:20px;margin:10px 0}
.lang-title{text-align:center;font-size:9px;font-weight:900;color:#6b7280;margin-bottom:8px}
.languages{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.lang{border:1px solid #ddd;background:#f8fafc;border-radius:8px;padding:10px;font-weight:800;font-size:10px;cursor:pointer}
.lang.active{background:#111827;color:#fff}

.content{margin-top:15px}
.section{padding:18px 0;border-bottom:1px solid #eee}
.section:last-child{border:0}
.section h2{font-size:10px;color:#6b7280;margin-bottom:8px}
.verse{background:#fffbea;border-left:4px solid #f59e0b;padding:15px;border-radius:8px;font-size:17px;font-weight:700}
.ref{display:block;color:#92400e;font-size:11px;margin-top:7px}
.title{font-size:19px;font-weight:900;margin-bottom:6px}
.text{font-size:14px;white-space:pre-line}
.prayer{background:#f5f3ff;border-left:4px solid #7c3aed;padding:15px;border-radius:8px}

.share{text-align:center;margin-top:15px}
.share button{background:#111827;color:#fff;border:0;border-radius:9px;padding:13px 22px;font-weight:900;cursor:pointer}
.status{text-align:center;padding:25px;color:#6b7280;font-size:12px}
.error{color:#dc2626}

.archive-title{text-align:center}
.archive-title h2{font-size:23px}
.archive-title p{font-size:10px;color:#6b7280}

.years{display:flex;justify-content:center;align-items:center;gap:10px;margin:18px 0}
.years button{width:35px;height:35px;border:1px solid #ddd;background:#f8fafc;border-radius:8px;cursor:pointer}
.year{font-size:17px;font-weight:900;min-width:65px;text-align:center}

.month{border:1px solid #e5e7eb;border-radius:12px;margin-bottom:10px;overflow:hidden}
.month-head{background:#f8fafc;padding:10px 12px;font-weight:900;font-size:12px;display:flex;justify-content:space-between}
.days{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;padding:8px}
.day-name{text-align:center;font-size:8px;color:#9ca3af;font-weight:900}
.day{border:1px solid #e5e7eb;background:#fff;border-radius:6px;min-height:36px;font-size:9px;font-weight:800;cursor:pointer}
.day:hover{background:#eef2ff}
.day.today{background:#111827;color:#fff}
.empty{border:0;background:transparent;cursor:default}

footer{background:#0b1120;color:#fff;margin-top:20px;padding:25px 0;text-align:center}
.footer-logo{width:38px;background:#fff;border-radius:7px;padding:3px}
footer strong{display:block;font-size:13px}
footer span{font-size:8px;color:#94a3b8}
.footer-links{display:flex;justify-content:center;gap:14px;flex-wrap:wrap;margin-top:12px}
.footer-links a{font-size:9px;color:#cbd5e1}
.copy{border-top:1px solid #ffffff18;margin-top:15px;padding-top:12px;font-size:8px;color:#64748b}

.whatsapp{position:fixed;right:15px;bottom:15px;width:50px;height:50px;border-radius:50%;background:#25d366;color:#fff;display:grid;place-items:center;font-size:23px}

@media(max-width:650px){
.nav-links{display:none}
.menu{display:block}
.languages{grid-template-columns:1fr}
.box{padding:16px}
.text{font-size:13px}
.verse{font-size:15px}
}
</style>
</head>

<body>

<header>
<div class="container nav">

<a href="index.html" class="logo">
<img src="https://files.gohministries.org/file_00000000f02c82088b7cf2676012b775.png">
<div>
<div class="logo-title">GOH Ministries</div>
<div class="logo-sub">Gate of Heaven Ministries</div>
</div>
</a>

<nav class="nav-links">
<a href="index.html">🏠 Home</a>
<a href="about.html">About</a>
<a href="contact.html">Contact</a>
<a href="donate.html">Donate</a>
</nav>

<button class="menu" id="menu">☰</button>

</div>
</header>

<div class="container">

<section class="hero">
<div class="hero-card">

<img class="hero-logo" src="https://files.gohministries.org/file_00000000f02c82088b7cf2676012b775.png">

<div class="label">GATE OF HEAVEN MINISTRIES</div>

<h1>🙏 Daily Devotional</h1>

<p>Bible Verse • Explanation • Prayer</p>

<div class="date" id="date"></div>

</div>
</section>

<div class="box">

<div class="lang-title">LANGUAGE</div>

<div class="languages">

<button class="lang" data-lang="en">🇬🇧 English</button>
<button class="lang" data-lang="ta">🇱🇰 தமிழ்</button>
<button class="lang" data-lang="si">🇱🇰 සිංහල</button>

</div>
</div>

<div class="box">

<div id="result" class="status">
Loading devotional...
</div>

<div class="share" id="share" style="display:none">
<button onclick="shareDevotional()">📤 Share Full Devotional</button>
</div>

</div>

<div class="box">

<div class="archive-title">
<div class="label">DEVOTIONAL ARCHIVE</div>
<h2>📅 Previous Devotionals</h2>
<p>Select any date from the calendar.</p>
</div>

<div class="years">
<button onclick="changeYear(-1)">‹</button>
<div class="year" id="year"></div>
<button onclick="changeYear(1)">›</button>
</div>

<div id="archive"></div>

</div>

</div>

<footer>

<img class="footer-logo" src="https://files.gohministries.org/file_00000000f02c82088b7cf2676012b775.png">

<strong>GOH Ministries</strong>
<span>Gate of Heaven Ministries</span>

<div class="footer-links">
<a href="index.html">Home</a>
<a href="about.html">About</a>
<a href="contact.html">Contact</a>
<a href="donate.html">Donate</a>
<a href="privacy.html">Privacy</a>
<a href="terms.html">Terms</a>
<a href="disclaimer.html">Disclaimer</a>
</div>

<div class="copy">
© 2026 GOH Ministries. All rights reserved.
</div>

</footer>

<a class="whatsapp" href="https://wa.me/94771190395" target="_blank">💬</a>

<script>

const API="https://devotional.createlk.workers.dev";

let params=new URLSearchParams(location.search);
let lang=params.get("lang")||"en";
let selected=params.get("date");
let year=new Date().getFullYear();

if(!["en","ta","si"].includes(lang))lang="en";

const months=[
"January","February","March","April","May","June",
"July","August","September","October","November","December"
];

function today(){
let d=new Date();
return String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0");
}

function dateText(md){
let [m,d]=md.split("-");
return new Date(year,m-1,d).toLocaleDateString(
"en-US",{month:"long",day:"numeric",year:"numeric"}
);
}

function setURL(){
let p=new URLSearchParams();
p.set("lang",lang);
if(selected)p.set("date",selected);
history.replaceState({}, "", "devotional.html?"+p);
}

async function load(md){

selected=md;

document.getElementById("date").textContent=dateText(md);

let box=document.getElementById("result");
let share=document.getElementById("share");

share.style.display="none";
box.className="status";
box.innerHTML="Loading devotional...";

try{

let r=await fetch(
API+"?date="+encodeURIComponent(md)+"&lang="+lang,
{cache:"no-store"}
);

let data=await r.json();

if(!r.ok||!data.success){

box.className="status error";
box.textContent="⚠️ "+(data.error||"Devotional not available yet.");
return;
}

let x=data.devotional;

box.className="content";

box.innerHTML=`

<div class="section">

<h2>📖 BIBLE VERSE</h2>

<div class="verse">
${safe(x.bible_verse)}
<span class="ref">${safe(x.bible_reference)}</span>
</div>

</div>

<div class="section">

<h2>💡 EXPLANATION</h2>

<div class="title">${safe(x.title)}</div>
<div class="text">${safe(x.message)}</div>

</div>

<div class="section">

<h2>🙏 PRAYER</h2>

<div class="prayer text">${safe(x.prayer)}</div>

</div>
`;

share.style.display="block";

setURL();

}catch(e){

box.className="status error";
box.textContent="⚠️ Failed to fetch devotional.";

}

}

function safe(x){
return String(x||"")
.replace(/&/g,"&amp;")
.replace(/</g,"&lt;")
.replace(/>/g,"&gt;")
.replace(/"/g,"&quot;")
.replace(/'/g,"&#039;")
.replace(/\n/g,"<br>");
}

async function shareDevotional(){

let text=document.getElementById("result").innerText+
"\n\n"+location.href;

if(navigator.share){

await navigator.share({
title:"GOH Ministries Daily Devotional",
text:text
});

}else{

await navigator.clipboard.writeText(text);
alert("Devotional copied. You can share it.");

}

}

document.querySelectorAll(".lang").forEach(b=>{

b.onclick=()=>{
lang=b.dataset.lang;

document.querySelectorAll(".lang")
.forEach(x=>x.classList.toggle("active",x===b));

load(selected||today());
};

});

function calendar(){

document.getElementById("year").textContent=year;

let out="";

for(let m=0;m<12;m++){

let first=new Date(year,m,1).getDay();
let total=new Date(year,m+1,0).getDate();

out+=`
<div class="month">

<div class="month-head">
<span>${months[m]}</span>
<span>${year}</span>
</div>

<div class="days">

<div class="day-name">Sun</div>
<div class="day-name">Mon</div>
<div class="day-name">Tue</div>
<div class="day-name">Wed</div>
<div class="day-name">Thu</div>
<div class="day-name">Fri</div>
<div class="day-name">Sat</div>
`;

for(let i=0;i<first;i++)
out+=`<div class="day empty"></div>`;

for(let d=1;d<=total;d++){

let md=String(m+1).padStart(2,"0")+"-"+String(d).padStart(2,"0");

let cls="day";

if(year===new Date().getFullYear()&&md===today())
cls+=" today";

out+=`
<button class="${cls}" onclick="openDate('${md}')">
${d}
</button>
`;

}

out+=`</div></div>`;

}

document.getElementById("archive").innerHTML=out;

}

function openDate(md){

year=parseInt(md.slice(0,2))||year;

load(md);

window.scrollTo({top:0,behavior:"smooth"});

}

function changeYear(n){

year+=n;
calendar();

}

document.getElementById("menu").onclick=()=>{
document.querySelector(".nav-links").style.display=
document.querySelector(".nav-links").style.display==="flex"?"none":"flex";
};

document.querySelectorAll(".lang")
.forEach(x=>x.classList.toggle("active",x.dataset.lang===lang));

calendar();

load(selected||today());

</script>

</body>
</html>
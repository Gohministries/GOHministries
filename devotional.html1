<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Today's Devotional | GOH Ministries</title>

<meta name="description"
content="Daily Christian devotional with Bible verse, explanation and prayer from GOH Ministries.">

<meta name="theme-color" content="#111827">

<style>
*{
box-sizing:border-box;
margin:0;
padding:0
}

body{
font-family:Arial,Helvetica,sans-serif;
background:#f3f6fb;
color:#172033;
line-height:1.6
}

.container{
width:min(850px,92%);
margin:auto
}

/* HEADER */

header{
position:sticky;
top:0;
z-index:100;
background:#fff;
border-bottom:1px solid #e5e7eb
}

.nav{
min-height:62px;
display:flex;
align-items:center;
justify-content:space-between;
gap:10px
}

.logo{
text-decoration:none;
color:#111827
}

.logo-title{
font-size:13px;
font-weight:900
}

.logo-sub{
font-size:8px;
color:#6b7280
}

.home{
text-decoration:none;
background:#111827;
color:#fff;
padding:8px 12px;
border-radius:9px;
font-size:9px;
font-weight:900
}

/* MAIN */

main{
padding:22px 0 40px
}

/* HERO */

.hero{
background:
radial-gradient(
circle at 90% 10%,
rgba(99,102,241,.35),
transparent 32%
),
linear-gradient(
135deg,
#111827,
#293548
);
color:#fff;
border-radius:22px;
padding:30px 20px;
text-align:center;
margin-bottom:12px
}

.hero-icon{
font-size:34px
}

.hero-label{
color:#fbbf24;
font-size:8px;
font-weight:900;
letter-spacing:1.2px;
margin-top:3px
}

.hero h1{
font-size:28px;
line-height:1.2;
margin:6px 0
}

.date{
color:#cbd5e1;
font-size:10px
}

/* LANGUAGE */

.language-card{
background:#fff;
border:1px solid #e5e7eb;
border-radius:14px;
padding:13px;
margin-bottom:12px
}

.language-card label{
display:block;
font-size:8px;
font-weight:900;
color:#6b7280;
margin-bottom:6px
}

select{
width:100%;
padding:10px;
border:1px solid #d1d5db;
border-radius:9px;
background:#fff;
color:#172033;
font-size:11px;
font-weight:700;
outline:none
}

/* CARDS */

.card{
background:#fff;
border:1px solid #e5e7eb;
border-radius:16px;
padding:21px;
margin-bottom:12px;
box-shadow:0 5px 18px rgba(15,23,42,.04)
}

.card-label{
font-size:8px;
font-weight:900;
letter-spacing:1px;
margin-bottom:8px
}

/* VERSE */

.verse-card{
background:linear-gradient(
135deg,
#fffbeb,
#fff7d6
);
border-color:#fde68a
}

.verse-card .card-label{
color:#b45309
}

.verse{
font-size:16px;
font-weight:700;
font-style:italic;
color:#374151
}

.reference{
display:inline-block;
margin-top:10px;
padding:5px 9px;
border-radius:7px;
background:#fef3c7;
color:#92400e;
font-size:9px;
font-weight:900
}

/* MESSAGE */

.message-card .card-label{
color:#4f46e5
}

.message-card h2{
font-size:21px;
line-height:1.3;
margin-bottom:10px
}

.message{
font-size:13px;
color:#374151;
white-space:pre-line
}

/* PRAYER */

.prayer-card{
background:linear-gradient(
135deg,
#eef2ff,
#f8faff
);
border-color:#c7d2fe
}

.prayer-card .card-label{
color:#4338ca
}

.prayer-card h2{
font-size:21px;
margin-bottom:10px
}

.prayer{
font-size:13px;
color:#374151;
white-space:pre-line
}

/* LOADING */

.loading{
background:#fff;
border:1px solid #e5e7eb;
border-radius:16px;
padding:40px 15px;
text-align:center;
color:#6b7280;
font-size:11px
}

/* ERROR */

.error{
background:#fef2f2;
border:1px solid #fecaca;
color:#b91c1c;
border-radius:14px;
padding:20px;
text-align:center;
font-size:10px;
font-weight:700
}

/* SHARE */

.share{
text-align:center;
margin-top:15px
}

.share button{
border:0;
background:#111827;
color:#fff;
padding:11px 18px;
border-radius:10px;
font-size:10px;
font-weight:900;
cursor:pointer
}

.share button:active{
transform:scale(.98)
}

.share-status{
font-size:9px;
color:#16a34a;
font-weight:700;
margin-top:7px;
min-height:14px
}

/* FOOTER */

footer{
background:#0b1120;
color:#94a3b8;
text-align:center;
padding:20px;
font-size:8px
}

footer strong{
color:#fff
}

/* MOBILE */

@media(max-width:600px){

.container{
width:92%
}

.hero{
padding:26px 18px;
border-radius:19px
}

.hero h1{
font-size:24px
}

.card{
padding:18px
}

.message-card h2,
.prayer-card h2{
font-size:19px
}

.message,
.prayer{
font-size:12px
}

.verse{
font-size:14px
}

}
</style>
</head>

<body>

<header>

<div class="container nav">

<a href="index.html" class="logo">

<div class="logo-title">
GOH Ministries
</div>

<div class="logo-sub">
Gate of Heaven Ministries
</div>

</a>

<a href="index.html" class="home">
🏠 Home
</a>

</div>

</header>


<main>

<div class="container">

<!-- HERO -->

<section class="hero">

<div class="hero-icon">
🙏
</div>

<div class="hero-label">
DAILY DEVOTIONAL
</div>

<h1>
Today's Devotional
</h1>

<div id="date" class="date">
Loading...
</div>

</section>


<!-- LANGUAGE -->

<section class="language-card">

<label>
SELECT LANGUAGE
</label>

<select id="language">

<option value="en">
🇬🇧 English
</option>

<option value="ta">
🇱🇰 தமிழ்
</option>

<option value="si">
🇱🇰 සිංහල
</option>

</select>

</section>


<!-- CONTENT -->

<div id="content">

<div class="loading">
📖 Loading today's devotional...
</div>

</div>


<!-- SHARE -->

<div class="share">

<button id="shareBtn">
📤 Share Full Devotional
</button>

<div id="shareStatus" class="share-status"></div>

</div>

</div>

</main>


<footer>

<strong>
GOH Ministries
</strong>

<br>

Gate of Heaven Ministries

<br>

Daily Devotional • Bible • Prayer

</footer>


<script>

/* =====================================
   CLOUDFLARE WORKER
===================================== */

const API =
"https://devotional.createlk.workers.dev";


/* =====================================
   LANGUAGE
===================================== */

const languageSelect =
document.getElementById("language");

let language =
localStorage.getItem(
"goh_devotional_language"
) || "en";

languageSelect.value =
language;


/* =====================================
   CURRENT DEVOTIONAL
===================================== */

let currentDevotional = null;


/* =====================================
   LOAD DEVOTIONAL
===================================== */

async function loadDevotional(){

const content =
document.getElementById("content");

content.innerHTML = `
<div class="loading">
📖 Loading today's devotional...
</div>
`;

currentDevotional = null;

try{

const apiURL =
API +
"/?lang=" +
encodeURIComponent(language);


const response =
await fetch(
apiURL,
{
method:"GET",
headers:{
"Accept":"application/json"
},
cache:"no-store"
}
);


if(!response.ok){

throw new Error(
"Server error: " +
response.status
);

}


const text =
await response.text();

let data;

try{

data =
JSON.parse(text);

}catch(e){

throw new Error(
"Invalid response from devotional server."
);

}


if(!data.success){

throw new Error(
data.error ||
"Today's devotional is not available yet."
);

}


const d =
data.devotional;


/* SAVE FULL DEVOTIONAL FOR SHARING */

currentDevotional = {

date:data.date,

title:d.title || "",

verse:d.bible_verse || "",

reference:d.bible_reference || "",

message:d.message || "",

prayer:d.prayer || ""

};


/* DATE */

document.getElementById("date")
.textContent =
formatDate(data.date);


/* =====================================
   DISPLAY

   1. BIBLE VERSE
   2. EXPLANATION
   3. PRAYER
===================================== */

content.innerHTML = `

<!-- BIBLE VERSE -->

<article class="card verse-card">

<div class="card-label">
📖 BIBLE VERSE
</div>

<div class="verse">
“${escapeHTML(
d.bible_verse || ""
)}”
</div>

${
d.bible_reference
?
`
<div class="reference">
${escapeHTML(
d.bible_reference
)}
</div>
`
:
""
}

</article>


<!-- EXPLANATION -->

<article class="card message-card">

<div class="card-label">
💡 TODAY'S EXPLANATION
</div>

<h2>
${escapeHTML(
d.title || ""
)}
</h2>

<div class="message">
${escapeHTML(
d.message || ""
)}
</div>

</article>


<!-- PRAYER -->

<article class="card prayer-card">

<div class="card-label">
🙏 TODAY'S PRAYER
</div>

<h2>
Prayer
</h2>

<div class="prayer">
${escapeHTML(
d.prayer || ""
)}
</div>

</article>

`;


}catch(error){

console.error(
"Devotional API error:",
error
);

content.innerHTML = `

<div class="error">

⚠️ Today's devotional is not available yet.

<br><br>

Please try again later.

</div>

`;

}

}


/* =====================================
   FORMAT DATE
===================================== */

function formatDate(monthDay){

const parts =
String(monthDay).split("-");

if(parts.length !== 2){

return monthDay;

}

const date =
new Date(
2024,
Number(parts[0]) - 1,
Number(parts[1])
);

return date.toLocaleDateString(
"en-US",
{
month:"long",
day:"numeric"
}
);

}


/* =====================================
   ESCAPE HTML
===================================== */

function escapeHTML(value){

return String(
value ?? ""
)

.replace(
/&/g,
"&amp;"
)

.replace(
/</g,
"&lt;"
)

.replace(
/>/g,
"&gt;"
)

.replace(
/"/g,
"&quot;"
)

.replace(
/'/g,
"&#039;"
);

}


/* =====================================
   LANGUAGE CHANGE
===================================== */

languageSelect.addEventListener(
"change",
function(){

language =
this.value;

localStorage.setItem(
"goh_devotional_language",
language
);

loadDevotional();

}
);


/* =====================================
   SHARE FULL DEVOTIONAL
===================================== */

document
.getElementById("shareBtn")
.addEventListener(
"click",
async function(){

const status =
document.getElementById(
"shareStatus"
);


if(!currentDevotional){

status.textContent =
"Please wait for the devotional to load.";

return;

}


const d =
currentDevotional;


/*
   Full devotional text
*/

const shareText =

"🙏 GOH MINISTRIES\n" +

"DAILY DEVOTIONAL\n\n" +

"📖 BIBLE VERSE\n" +

(d.verse || "") +

"\n\n" +

(d.reference
? d.reference + "\n\n"
: "") +

"💡 " +

(d.title || "TODAY'S EXPLANATION") +

"\n\n" +

(d.message || "") +

"\n\n" +

"🙏 PRAYER\n\n" +

(d.prayer || "") +

"\n\n" +

"— GOH Ministries\n" +

window.location.href;


/*
   Native share
*/

if(navigator.share){

try{

await navigator.share({

title:
"Today's Devotional | GOH Ministries",

text:
shareText

});

status.textContent =
"✓ Shared successfully";

setTimeout(
()=>{
status.textContent="";
},
2000
);

return;

}catch(error){

/*
  User cancelled share.
  Do nothing.
*/

if(error.name === "AbortError"){

return;

}

}

}


/*
   Fallback: copy full devotional
*/

try{

await navigator.clipboard.writeText(
shareText
);

status.textContent =
"✓ Full devotional copied";

setTimeout(
()=>{
status.textContent="";
},
2500
);

}catch(error){

/*
   Older browsers fallback
*/

const textarea =
document.createElement("textarea");

textarea.value =
shareText;

textarea.style.position =
"fixed";

textarea.style.left =
"-9999px";

document.body.appendChild(
textarea
);

textarea.select();

try{

document.execCommand(
"copy"
);

status.textContent =
"✓ Full devotional copied";

}catch(e){

status.textContent =
"Unable to copy devotional.";

}

document.body.removeChild(
textarea
);

setTimeout(
()=>{
status.textContent="";
},
2500
);

}

}
);


/* =====================================
   START
===================================== */

loadDevotional();

</script>

</body>
</html>
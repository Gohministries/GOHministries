const ALLOWED_ORIGINS = [
  "https://gohministries.github.io",
  "https://gohministries.org",
  "https://www.gohministries.org"
];

function cors(request) {
  const origin = request.headers.get("Origin");

  return {
    "Content-Type": "application/json",
    "Access-Control-Allow-Origin":
      ALLOWED_ORIGINS.includes(origin)
        ? origin
        : "https://gohministries.github.io",
    "Access-Control-Allow-Headers":
      "Content-Type, Authorization",
    "Access-Control-Allow-Methods":
      "GET, POST, OPTIONS",
    "Vary": "Origin"
  };
}

function json(request, data, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: cors(request)
  });
}

function error(request, message, status = 400) {
  return json(request, {
    success: false,
    error: message
  }, status);
}

function randomHex(bytes = 32) {
  const data = crypto.getRandomValues(
    new Uint8Array(bytes)
  );

  return Array.from(data)
    .map(x => x.toString(16).padStart(2, "0"))
    .join("");
}

async function sha256(text) {
  const data = new TextEncoder().encode(text);

  const hash = await crypto.subtle.digest(
    "SHA-256",
    data
  );

  return Array.from(new Uint8Array(hash))
    .map(x => x.toString(16).padStart(2, "0"))
    .join("");
}

async function hashPassword(password) {
  const salt = randomHex(16);
  const iterations = 100000;

  const key = await crypto.subtle.importKey(
    "raw",
    new TextEncoder().encode(password),
    "PBKDF2",
    false,
    ["deriveBits"]
  );

  const bits = await crypto.subtle.deriveBits(
    {
      name: "PBKDF2",
      salt: new TextEncoder().encode(salt),
      iterations,
      hash: "SHA-256"
    },
    key,
    256
  );

  const hash = Array.from(new Uint8Array(bits))
    .map(x => x.toString(16).padStart(2, "0"))
    .join("");

  return `pbkdf2$${iterations}$${salt}$${hash}`;
}

async function verifyPassword(password, stored) {
  const parts = stored.split("$");

  if (parts.length !== 4 || parts[0] !== "pbkdf2") {
    return false;
  }

  const iterations = Number(parts[1]);
  const salt = parts[2];
  const expected = parts[3];

  if (!iterations || iterations > 100000) {
    return false;
  }

  const key = await crypto.subtle.importKey(
    "raw",
    new TextEncoder().encode(password),
    "PBKDF2",
    false,
    ["deriveBits"]
  );

  const bits = await crypto.subtle.deriveBits(
    {
      name: "PBKDF2",
      salt: new TextEncoder().encode(salt),
      iterations,
      hash: "SHA-256"
    },
    key,
    256
  );

  const actual = Array.from(new Uint8Array(bits))
    .map(x => x.toString(16).padStart(2, "0"))
    .join("");

  return actual === expected;
}

async function createSession(studentId, env) {
  const token = randomHex(32);
  const tokenHash = await sha256(token);

  const expiresAt = new Date(
    Date.now() + 7 * 24 * 60 * 60 * 1000
  ).toISOString();

  await env.DB.prepare(`
    INSERT INTO sessions
    (student_id, token_hash, expires_at)
    VALUES (?, ?, ?)
  `)
    .bind(studentId, tokenHash, expiresAt)
    .run();

  return token;
}

async function getStudent(request, env) {
  const auth = request.headers.get("Authorization");

  if (!auth || !auth.startsWith("Bearer ")) {
    return null;
  }

  const token = auth.substring(7);
  const tokenHash = await sha256(token);

  return await env.DB.prepare(`
    SELECT
      students.id,
      students.name,
      students.email,
      students.status
    FROM sessions
    JOIN students
      ON students.id = sessions.student_id
    WHERE sessions.token_hash = ?
      AND sessions.expires_at > CURRENT_TIMESTAMP
      AND students.status = 'ACTIVE'
    LIMIT 1
  `)
    .bind(tokenHash)
    .first();
}

export default {
  async fetch(request, env) {

    if (request.method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers: cors(request)
      });
    }

    const url = new URL(request.url);
    const path = url.pathname;

    try {

      if (
        path === "/register" &&
        request.method === "POST"
      ) {

        const body = await request.json();

        const name = String(body.name || "").trim();
        const email = String(body.email || "")
          .trim()
          .toLowerCase();
        const password = String(body.password || "");

        if (!name || !email || !password) {
          return error(
            request,
            "Name, email and password are required."
          );
        }

        if (!email.includes("@")) {
          return error(
            request,
            "Enter a valid email address."
          );
        }

        if (password.length < 8) {
          return error(
            request,
            "Password must be at least 8 characters."
          );
        }

        const existing = await env.DB.prepare(`
          SELECT id
          FROM students
          WHERE email = ?
          LIMIT 1
        `)
          .bind(email)
          .first();

        if (existing) {
          return error(
            request,
            "An account with this email already exists.",
            409
          );
        }

        const passwordHash =
          await hashPassword(password);

        const result = await env.DB.prepare(`
          INSERT INTO students
          (name, email, password_hash)
          VALUES (?, ?, ?)
        `)
          .bind(name, email, passwordHash)
          .run();

        return json(request, {
          success: true,
          message: "Registration successful.",
          student_id: result.meta.last_row_id
        }, 201);
      }

      if (
        path === "/login" &&
        request.method === "POST"
      ) {

        const body = await request.json();

        const email = String(body.email || "")
          .trim()
          .toLowerCase();

        const password = String(body.password || "");

        if (!email || !password) {
          return error(
            request,
            "Email and password are required."
          );
        }

        const student = await env.DB.prepare(`
          SELECT *
          FROM students
          WHERE email = ?
          LIMIT 1
        `)
          .bind(email)
          .first();

        if (!student) {
          return error(
            request,
            "Invalid email or password.",
            401
          );
        }

        if (student.status !== "ACTIVE") {
          return error(
            request,
            "Your account is not active.",
            403
          );
        }

        const valid = await verifyPassword(
          password,
          student.password_hash
        );

        if (!valid) {
          return error(
            request,
            "Invalid email or password.",
            401
          );
        }

        const token = await createSession(
          student.id,
          env
        );

        return json(request, {
          success: true,
          message: "Login successful.",
          token,
          student: {
            id: student.id,
            name: student.name,
            email: student.email
          }
        });
      }

      if (
        path === "/me" &&
        request.method === "GET"
      ) {

        const student =
          await getStudent(request, env);

        if (!student) {
          return error(
            request,
            "Not authenticated.",
            401
          );
        }

        return json(request, {
          success: true,
          student
        });
      }

      if (
        path === "/logout" &&
        request.method === "POST"
      ) {

        const auth =
          request.headers.get("Authorization");

        if (auth && auth.startsWith("Bearer ")) {

          const token = auth.substring(7);
          const tokenHash = await sha256(token);

          await env.DB.prepare(`
            DELETE FROM sessions
            WHERE token_hash = ?
          `)
            .bind(tokenHash)
            .run();
        }

        return json(request, {
          success: true,
          message: "Logged out."
        });
      }

      if (
        path === "/forgot-password" &&
        request.method === "POST"
      ) {

        const body = await request.json();

        const email = String(body.email || "")
          .trim()
          .toLowerCase();

        if (!email) {
          return error(
            request,
            "Email address is required."
          );
        }

        const student = await env.DB.prepare(`
          SELECT id
          FROM students
          WHERE email = ?
          LIMIT 1
        `)
          .bind(email)
          .first();

        if (student) {

          const token = randomHex(32);
          const tokenHash = await sha256(token);

          const expiresAt = new Date(
            Date.now() + 30 * 60 * 1000
          ).toISOString();

          await env.DB.prepare(`
            UPDATE password_resets
            SET used = 1
            WHERE student_id = ?
            AND used = 0
          `)
            .bind(student.id)
            .run();

          await env.DB.prepare(`
            INSERT INTO password_resets
            (student_id, token_hash, expires_at)
            VALUES (?, ?, ?)
          `)
            .bind(
              student.id,
              tokenHash,
              expiresAt
            )
            .run();
        }

        return json(request, {
          success: true,
          message:
            "If the account exists, reset instructions will be sent."
        });
      }

      if (
        path === "/reset-password" &&
        request.method === "POST"
      ) {

        const body = await request.json();

        const token = String(body.token || "");
        const password = String(body.password || "");

        if (!token || !password) {
          return error(
            request,
            "Reset token and new password are required."
          );
        }

        if (password.length < 8) {
          return error(
            request,
            "Password must be at least 8 characters."
          );
        }

        const tokenHash = await sha256(token);

        const reset = await env.DB.prepare(`
          SELECT *
          FROM password_resets
          WHERE token_hash = ?
          AND used = 0
          AND expires_at > CURRENT_TIMESTAMP
          LIMIT 1
        `)
          .bind(tokenHash)
          .first();

        if (!reset) {
          return error(
            request,
            "Invalid or expired reset link."
          );
        }

        const passwordHash =
          await hashPassword(password);

        await env.DB.prepare(`
          UPDATE students
          SET password_hash = ?,
              updated_at = CURRENT_TIMESTAMP
          WHERE id = ?
        `)
          .bind(passwordHash, reset.student_id)
          .run();

        await env.DB.prepare(`
          UPDATE password_resets
          SET used = 1
          WHERE id = ?
        `)
          .bind(reset.id)
          .run();

        await env.DB.prepare(`
          DELETE FROM sessions
          WHERE student_id = ?
        `)
          .bind(reset.student_id)
          .run();

        return json(request, {
          success: true,
          message: "Password changed successfully."
        });
      }

      return error(
        request,
        "Endpoint not found.",
        404
      );

    } catch (e) {

      console.error("AUTH API ERROR:", e);

      return json(
        request,
        {
          success: false,
          error: e?.message || String(e)
        },
        500
      );
    }
  }
};